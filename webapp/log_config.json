{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {"below_warning": {"()": "webapp.log_config.BelowWarning"}},
  "formatters": {
    "default": {"()": "uvicorn.logging.DefaultFormatter", "fmt": "%(levelprefix)s %(message)s", "use_colors": false},
    "access": {"()": "uvicorn.logging.AccessFormatter", "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s", "use_colors": false}
  },
  "handlers": {
    "info": {"formatter": "default", "class": "logging.StreamHandler", "stream": "ext://sys.stdout", "filters": ["below_warning"]},
    "problems": {"formatter": "default", "class": "logging.StreamHandler", "stream": "ext://sys.stderr", "level": "WARNING"},
    "access": {"formatter": "access", "class": "logging.StreamHandler", "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["info", "problems"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false}
  }
}
