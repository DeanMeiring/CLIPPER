# Copy this file to .env and fill in your key, or just set the env var
# yourself before running clipper.
#
# Get a key at https://console.anthropic.com/ (pay-as-you-go; this tool's
# text-only prompts are cheap -- a few cents per video even on long ones).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override which Claude model picks the clips. Check
# https://docs.claude.com/en/docs/about-claude/models for current ids.
# CLIPPER_MODEL=claude-sonnet-4-5
