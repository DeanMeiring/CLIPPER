# Copy this file to .env and fill in your key, or just set the env var
# yourself before running clipper.
#
# Get a key at https://console.anthropic.com/ (pay-as-you-go; this tool's
# text-only prompts are cheap -- a few cents per video even on long ones).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override which Claude model picks the clips (default
# claude-opus-5), and the model used for everything else. Check
# https://docs.claude.com/en/docs/about-claude/models for current ids.
# CLIPPER_SELECT_MODEL=claude-opus-5
# CLIPPER_MODEL=claude-opus-5
#
# Every other setting (web app, YouTube, Twitch, Telegram, long-form) is
# listed in the README's "Environment variables" table.
